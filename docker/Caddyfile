# Caddy saca y renueva el certificado solo, siempre que el dominio apunte a
# este servidor y los puertos 80 y 443 estén abiertos.
#
# Para probar sin dominio, poner DOMINIO=:80 en el .env: ahí sirve por HTTP
# en la IP del servidor, sin certificado.
{$DOMINIO} {
	encode zstd gzip

	# El tamaño de las fotos que se suben desde el admin.
	request_body {
		max_size 25MB
	}

	reverse_proxy app:3000
}
