# ─── Base de datos ───────────────────────────────────────────────────────────
# Ajustá usuario y contraseña según tu Postgres local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bodega_dev?schema=public"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3021"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ─── Mercado Pago ────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# ─── Email (SMTP). Vacío => ConsoleEmailProvider (log en consola) ────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Bodega Aurora <hola@bodega.test>"

# ─── Storage. local | s3 ─────────────────────────────────────────────────────
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ─── Shipping. mock | enviopack | andreani | oca | correo_argentino ──────────
SHIPPING_DEFAULT_PROVIDER="mock"

# ── Envíopack ────────────────────────────────────────────────────────────────
# Intermediario: con una cuenta cotiza varios correos y no hace falta contrato
# propio con cada uno. Las claves se sacan en app.enviopack.com/configuraciones-api
#   ENVIOPACK_MODALIDAD  "D" a domicilio (por defecto) o "S" a sucursal
ENVIOPACK_API_KEY=""
ENVIOPACK_SECRET_KEY=""
ENVIOPACK_MODALIDAD="D"
# Depósito desde donde retiran. Se saca de Configuración / Depósitos en el panel
# de Envíopack. Sin esto se puede cotizar pero no despachar.
ENVIOPACK_DIRECCION_ENVIO=""
# "D" retiran por el depósito (por defecto) o "S" lo llevás a una sucursal.
ENVIOPACK_DESPACHO="D"
# Secreto propio para los avisos de Envíopack. Ellos no firman sus llamadas, así
# que va en la URL que se registra en su panel:
#   https://tudominio.com/api/webhooks/envios/enviopack?secreto=ESTE-VALOR
# Sin esto el endpoint rechaza todo.
ENVIOPACK_WEBHOOK_SECRET=""

# ── Andreani ─────────────────────────────────────────────────────────────────
# Credenciales del cotizador. Se generan en andreani.com > Integraciones y hay
# que ser cliente. Sin las cuatro primeras, el proveedor queda apagado y la
# tienda cotiza con las zonas del admin.
#   ANDREANI_CLIENTE   código de cliente, lo da el comercial al abrir la cuenta
#   ANDREANI_CONTRATO  número de contrato acordado
#   ANDREANI_AMBIENTE  "qa" (por defecto) o "prod". Vacío o mal escrito = qa.
ANDREANI_USUARIO=""
ANDREANI_CLAVE=""
ANDREANI_CLIENTE=""
ANDREANI_CONTRATO=""
ANDREANI_AMBIENTE="qa"
# Opcionales
ANDREANI_SUCURSAL_ORIGEN=""
# Volumen por botella en cm3, si la caja propia resulta distinta de la estimada.
ANDREANI_CM3_POR_BOTELLA=""

# ─── Jobs / cron ─────────────────────────────────────────────────────────────
CRON_SECRET="cambiar-en-produccion"
